# Copy to .env and edit. Every value below is optional: with an empty .env the
# project runs on SQLite with the offline routing provider.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Database -------------------------------------------------------------
# DB_ENGINE=sqlite (default) or postgres
DB_ENGINE=sqlite
# DB_NAME=fuel_routes
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- Routing provider -----------------------------------------------------
# api.routing.openrouteservice.OpenRouteServiceProvider (default, needs a key)
# api.routing.static.StaticRouteProvider                (offline, no key)
ROUTE_PROVIDER=api.routing.openrouteservice.OpenRouteServiceProvider
ORS_API_KEY=
# ORS_TIMEOUT_SECONDS=10
# ROUTE_CACHE_SECONDS=3600

# --- Fuel prices ----------------------------------------------------------
# FUEL_PRICE_SOURCE=api.stations.database.DatabaseFuelPriceSource
# FUEL_PRICES_CSV=fuel_prices_sample.csv
# STATION_INDEX_CACHE_SECONDS=300

# --- Planner defaults -----------------------------------------------------
# DEFAULT_VEHICLE_MPG=10
# DEFAULT_TANK_RANGE_MILES=500
# FUEL_STOP_CORRIDOR_MILES=50
# MAX_ROUTE_POINTS_RETURNED=2000
